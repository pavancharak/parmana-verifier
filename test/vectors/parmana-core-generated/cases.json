    {
      "name": "tampered dilithium signature is refused, ed25519 still verifies",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "legacy",
        "checks": {
          "signature": true,
          "hybridSignatures": false
        }
      },
      "tamper": [
        {
          "path": "signatures.1.signature",
          "value": ""
        }
      ]
    },
    {
      "name": "record checked against another run's trust is refused",
      "record": "v3-record-1.json",
      "trust": "trust-v2.json",
      "expect": {
        "valid": false,
        "coverage": "legacy",
        "checks": {
          "signature": false
        }
      }
    },
    {
      "name": "ed25519 key marked compromised is refused",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "legacy",
        "errorIncludes": "compromised"
      },
      "trustEdits": [
        {
          "keyId": "default",
          "set": {
            "compromised": true
          }
        }
      ]
    },
    {
      "name": "ed25519 key whose validity ended before the record is refused",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "legacy",
        "errorIncludes": "validity window"
      },
      "trustEdits": [
        {
          "keyId": "default",
          "set": {
            "validUntil": "2026-11-14T00:00:00.000Z"
          }
        }
      ]
    },
    {
      "name": "ed25519 key not valid until later is refused",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "legacy",
        "errorIncludes": "validity window"
      },
      "trustEdits": [
        {
          "keyId": "default",
          "set": {
            "validFrom": "2099-01-01T00:00:00.000Z"
          }
        }
      ]
    },
    {
      "name": "ed25519 key missing from the trust file is refused",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "legacy",
        "errorIncludes": "no trusted key for keyId"
      },
      "trustEdits": [
        {
          "remove": "default"
        }
      ]
    },
    {
      "name": "dilithium key missing from the trust file is refused",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "legacy"
      },
      "trustEdits": [
        {
          "remove": "default-secondary"
        }
      ]
    }
  ]
