{
  "source": "Generated with parmana-core's signing code (VerificationCrypto.signWholeRecord) at branch claude/v3-only-records, decision D24. Test key material only. Single-record and hybrid fixtures are signed with ephemeral keys.",
  "cases": [
    {
      "name": "v3 hybrid record verifies with its trust file",
      "record": "v3-hybrid-record.json",
      "trust": "trust-v3-hybrid.json",
      "expect": {
        "valid": true,
        "checks": {
          "trustRecordHash": true,
          "signatures": true
        },
        "correspondence": "not_checked"
      }
    },
    {
      "name": "v3 single record verifies in single mode",
      "record": "v3-single-record.json",
      "trust": "trust-v3-single.json",
      "expect": {
        "valid": true,
        "checks": {
          "trustRecordHash": true,
          "signatures": true
        },
        "correspondence": "not_checked"
      }
    },
    {
      "name": "v3 single record verifies before a cutover it predates",
      "record": "v3-single-record.json",
      "trust": "trust-v3-single.json",
      "trustFields": {
        "hybridRequiredFrom": "2999-01-01T00:00:00.000Z"
      },
      "expect": {
        "valid": true,
        "checks": {
          "trustRecordHash": true,
          "signatures": true
        }
      }
    },
    {
      "name": "v3 single record is refused at or after the cutover (both entries required)",
      "record": "v3-single-record.json",
      "trust": "trust-v3-single.json",
      "trustFields": {
        "hybridRequiredFrom": "2026-01-01T00:00:00.000Z"
      },
      "expect": {
        "valid": false,
        "checks": {
          "signatures": false
        },
        "errorIncludes": "must carry both hybrid signatures"
      }
    },
    {
      "name": "changed amount is refused by the hash and the signatures",
      "record": "v3-hybrid-record.json",
      "trust": "trust-v3-hybrid.json",
      "tamper": [
        {
          "path": "transaction.signals.amount",
          "value": 999
        }
      ],
      "expect": {
        "valid": false,
        "checks": {
          "trustRecordHash": false,
          "signatures": false
        }
      }
    },
    {
      "name": "changed updatedAt is refused by the signatures alone (hash still matches)",
      "record": "v3-hybrid-record.json",
      "trust": "trust-v3-hybrid.json",
      "tamper": [
        {
          "path": "updatedAt",
          "value": "2026-02-01T00:00:00.000Z"
        }
      ],
      "expect": {
        "valid": false,
        "checks": {
          "trustRecordHash": true,
          "signatures": false
        }
      }
    },
    {
      "name": "a field added after signing is refused",
      "record": "v3-hybrid-record.json",
      "trust": "trust-v3-hybrid.json",
      "tamper": [
        {
          "path": "addedAfterSigning",
          "value": "x"
        }
      ],
      "expect": {
        "valid": false,
        "checks": {
          "signatures": false
        }
      }
    },
    {
      "name": "schemaVersion relabelled to 2 is refused",
      "record": "v3-hybrid-record.json",
      "trust": "trust-v3-hybrid.json",
      "tamper": [
        {
          "path": "schemaVersion",
          "value": 2
        }
      ],
      "expect": {
        "valid": false,
        "errorIncludes": "only schemaVersion 3"
      }
    },
    {
      "name": "Ed25519 signature replaced is refused",
      "record": "v3-hybrid-record.json",
      "trust": "trust-v3-hybrid.json",
      "tamper": [
        {
          "path": "signatures.0.signature",
          "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=="
        }
      ],
      "expect": {
        "valid": false,
        "checks": {
          "signatures": false
        }
      }
    },
    {
      "name": "ML-DSA signature replaced is refused",
      "record": "v3-hybrid-record.json",
      "trust": "trust-v3-hybrid.json",
      "tamper": [
        {
          "path": "signatures.1.signature",
          "value": ""
        }
      ],
      "expect": {
        "valid": false,
        "checks": {
          "signatures": false
        }
      }
    },
    {
      "name": "hybrid record checked against a trust set without its ML-DSA key is refused",
      "record": "v3-hybrid-record.json",
      "trust": "trust-v3-hybrid.json",
      "trustEdits": [
        {
          "remove": "whole-record-ml"
        }
      ],
      "expect": {
        "valid": false,
        "errorIncludes": "no trusted key"
      }
    },
    {
      "name": "hybrid record whose Ed25519 key is marked compromised is refused",
      "record": "v3-hybrid-record.json",
      "trust": "trust-v3-hybrid.json",
      "trustEdits": [
        {
          "keyId": "whole-record-ed",
          "set": {
            "compromised": true
          }
        }
      ],
      "expect": {
        "valid": false,
        "errorIncludes": "compromised"
      }
    },
    {
      "name": "single record whose key validity ended before the record is refused",
      "record": "v3-single-record.json",
      "trust": "trust-v3-single.json",
      "trustEdits": [
        {
          "keyId": "single-record-ed",
          "set": {
            "validUntil": "2026-01-01T00:00:00.000Z"
          }
        }
      ],
      "expect": {
        "valid": false,
        "errorIncludes": "validity window"
      }
    },
    {
      "name": "single record whose key is not valid until later is refused",
      "record": "v3-single-record.json",
      "trust": "trust-v3-single.json",
      "trustEdits": [
        {
          "keyId": "single-record-ed",
          "set": {
            "validFrom": "2027-01-01T00:00:00.000Z"
          }
        }
      ],
      "expect": {
        "valid": false,
        "errorIncludes": "validity window"
      }
    },
    {
      "name": "single record checked against another run's trust is refused",
      "record": "v3-single-record.json",
      "trust": "trust-v3-hybrid.json",
      "expect": {
        "valid": false,
        "errorIncludes": "no trusted key"
      }
    },
    {
      "name": "tampered single record is refused",
      "record": "v3-single-record.json",
      "trust": "trust-v3-single.json",
      "tamper": [
        {
          "path": "transaction.signals.amount",
          "value": 999
        }
      ],
      "expect": {
        "valid": false,
        "checks": {
          "trustRecordHash": false,
          "signatures": false
        }
      }
    }
  ]
}
