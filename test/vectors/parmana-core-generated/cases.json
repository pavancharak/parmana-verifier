          "value": "bogus"
        }
      ]
    },
    {
      "name": "tampered trustRecordId is refused",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "legacy"
      },
      "tamper": [
        {
          "path": "trustRecordId",
          "value": "00000000-0000-4000-8000-000000000000"
        }
      ]
    },
    {
      "name": "tampered ed25519 signature is refused, hybrid still verifies",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "full",
        "checks": {
          "signature": false,
          "hybridSignatures": true
        }
      },
      "tamper": [
        {
          "path": "signature.value",
          "value": "MLSTKSk/Nj1UVMWNzzLE/5pUqlEBMVCSLingm3bI4K/59DM2bM+o/G9vO9KGpUWDFYizOGUDEw1xq9ebVXclAAAA"
        }
      ]
