{
  "source": "Generated from the parmana-core working tree at commit 7e9a54fb (branch claude/status-events-code): an HTTP declare-then-execute export under CRYPTO_MODE=hybrid HYBRID_SCHEMA_VERSION=3 (v3), HYBRID_SCHEMA_VERSION=2 (v2), and CRYPTO_MODE=single (single). Test key material only, not for production.",
  "cases": [
    {
      "name": "v3 record 1 verifies with the run's trust",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": true,
        "coverage": "full",
        "checks": {
          "trustRecordHash": true,
          "signature": true,
          "hybridSignatures": true
        },
        "correspondence": "passed"
      }
    },
    {
      "name": "v3 record 2 verifies with the run's trust",
      "record": "v3-record-2.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": true,
        "coverage": "full",
        "checks": {
          "trustRecordHash": true,
          "signature": true,
          "hybridSignatures": true
        },
        "correspondence": "passed"
      }
    },
    {
      "name": "v3 record 3 verifies with the run's trust",
      "record": "v3-record-3.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": true,
        "coverage": "full",
        "checks": {
          "trustRecordHash": true,
          "signature": true,
          "hybridSignatures": true
        },
        "correspondence": "passed"
      }
    },
    {
      "name": "v2 record is refused by default",
      "record": "v2-record-1.json",
      "trust": "trust-v2.json",
      "expect": {
        "valid": false,
        "coverage": "legacy",
        "errorIncludes": "refused by default",
        "correspondence": "passed"
      }
    },
    {
      "name": "v2 record is accepted with allowLegacyV2 in the trust file",
      "record": "v2-record-1.json",
      "trust": "trust-v2-allow-legacy-v2.json",
      "expect": {
        "valid": true,
        "coverage": "legacy",
        "correspondence": "passed"
      }
    },
    {
      "name": "single-algorithm record is refused by default",
      "record": "single-record-1.json",
      "trust": "trust-single.json",
      "expect": {
        "valid": false,
        "coverage": "legacy",
        "errorIncludes": "refused by default",
        "correspondence": "passed"
      }
    },
    {
      "name": "single-algorithm record is accepted with allowLegacyV2 and allowLegacyOnly",
      "record": "single-record-1.json",
      "trust": "trust-single-allow-legacy.json",
      "expect": {
        "valid": true,
        "coverage": "legacy",
        "correspondence": "passed"
      }
    },
    {
      "name": "tampered transaction metadata is refused",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "legacy",
        "checks": {
          "trustRecordHash": false
        },
        "correspondence": "passed"
      },
      "tamper": [
        {
          "path": "transaction.metadata.grantedCapability",
          "value": "test:tampered"
        }
      ]
    },
    {
      "name": "tampered updatedAt is refused by the hybrid signatures only",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "legacy",
        "checks": {
          "signature": true,
          "hybridSignatures": false
        }
      },
      "tamper": [
        {
          "path": "updatedAt",
          "value": "2099-01-01T00:00:00.000Z"
        }
      ]
    },
    {
      "name": "tampered execution decision signal is refused",
      "record": "v3-record-1.json",
      "trust": "trust-v3.json",
      "expect": {
        "valid": false,
        "coverage": "legacy"
      },
      "tamper": [
        {
          "path": "executions.0.decision.signals.vendorVerified",
